rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isAdmin() {
      return signedIn() && userProfile(request.auth.uid).admin == true;
    }

    function publicQueueUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['queue', 'numOfPeople', 'dequeueTimes']);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.admin == false;
      allow update, delete: if isAdmin();
    }

    match /event/{eventId} {
      allow read: if true;
      allow update: if isAdmin() || publicQueueUpdateOnly();
      allow create, delete: if isAdmin();
    }
  }
}
